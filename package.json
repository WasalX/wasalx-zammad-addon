{
  "name": "@wasalx/zammad-addon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "format": "prettier --write",
    "format:check": "prettier --check",
    "zammad:package": "node scripts/build-zammad-package.mjs",
    "test:package": "node --experimental-strip-types --test tests/zammad-package.test.ts tests/ci-test-ownership.test.ts",
    "test:components": "pnpm --filter @wasalx/zammad-frontend-test test"
  },
  "prettier": {
    "endOfLine": "auto",
    "semi": false,
    "singleQuote": true
  },
  "stylelint": {
    "extends": "stylelint-config-standard",
    "overrides": [
      {
        "files": ["**/*.vue"],
        "customSyntax": "postcss-html"
      }
    ]
  },
  "devDependencies": {
    "oxlint": "1.94.0",
    "postcss-html": "1.8.1",
    "prettier": "3.10.1",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0"
  }
}
