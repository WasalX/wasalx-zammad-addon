{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "types": ["vitest/globals"],
    "paths": { "#shared/i18n/index.ts": ["./stubs/i18n.ts"] }
  },
  "include": ["*.ts", "stubs/*.ts"]
}
